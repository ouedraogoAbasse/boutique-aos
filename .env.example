# ====== Serveur ======
PORT=4000
NODE_ENV=development
# Origine du front en développement (CORS). En production le front est servi par Express.
CLIENT_ORIGIN=http://localhost:5173
# Secret JWT : générez-en un long et aléatoire
JWT_SECRET=changez-moi
# Cookies (true derrière HTTPS)
COOKIE_SECURE=false

# ====== Données (base SQLite + images) ======
# Par défaut : dossier ./data du projet. Sur Render : DATA_DIR=/var/data (disque persistant)
# DATA_DIR=./data

# ====== Super admin créé automatiquement au premier démarrage ======
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangezMoi123!
SUPER_ADMIN_NAME=Administrateur

# ====== Emails (SMTP) — facultatif ======
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=AOS Multi-Service International
